# PostgreSQL application database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pocket"
# A separate database whose name ends in _test; never use production here.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pocket_test"
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set an exact origin for hosting; local loopback requests work without this.
# APP_URL=http://localhost:3000
# Optional installed PostgreSQL binaries for npm run db:local.
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
